PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/email_tracker
# Public URL where this service is reachable by email clients (used to build the pixel URL)
BASE_URL=http://localhost:3000
# Serve Swagger UI at /docs and the OpenAPI spec at /openapi.json (true/false). Keep false in production.
ENABLE_SWAGGER=false
